<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ar</groupId>
        <artifactId>CRM2</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.ar</groupId>
    <artifactId>boot</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>CRM2 :: Boot</name>
    <description>Boot layer — Spring Boot entry point, wiring, and runtime composition.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Domain: boot is the composition root and may depend on all inner modules. -->
        <dependency>
            <groupId>com.ar</groupId>
            <artifactId>domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Application: use cases, services, and ports are wired from boot. -->
        <dependency>
            <groupId>com.ar</groupId>
            <artifactId>application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Infrastructure: boot -> infrastructure -> application -> domain.
             Infrastructure brings spring-boot-starter-web (controllers),
             spring-boot-starter-data-jpa (repositories), and the adapter implementations. -->
        <dependency>
            <groupId>com.ar</groupId>
            <artifactId>infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Mail for SMTP email notifications.
             Declared here (boot) because WiringConfig directly references JavaMailSender
             as a @Bean parameter. Do NOT rely on infrastructure's transitive propagation:
             the boot module's runtime classpath must include this starter explicitly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- H2 en memoria para el perfil noauth (desarrollo sin PostgreSQL) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring AI OpenAI provider starter for the A3 CRM agent.
             Declared here (boot) because AgentConfig and WiringConfig directly
             resolve the @Qualifier("openAiChatModel") ChatModel bean from
             OpenAiChatAutoConfiguration. The starter transitively brings in
             spring-ai-client-chat and spring-ai-autoconfigure-model-chat-client,
             so a separate spring-ai-client-chat dependency is redundant. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
